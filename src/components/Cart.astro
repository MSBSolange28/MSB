---
---

<button id="cart-toggle" class="cart-toggle" type="button" aria-label="Open cart" aria-expanded="false">
	<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="9" cy="20" r="1.4"></circle>
		<circle cx="18" cy="20" r="1.4"></circle>
		<path d="M2 2h3l2.4 12.6a1.6 1.6 0 0 0 1.6 1.3h8.7a1.6 1.6 0 0 0 1.6-1.3L21 6H6"></path>
	</svg>
	<span class="cart-count" id="cart-count" aria-label="Items in cart" hidden>0</span>
</button>

<div id="cart-overlay" class="cart-overlay" aria-hidden="true"></div>

<aside id="cart-drawer" class="cart-drawer" aria-hidden="true" aria-label="Shopping cart">
	<header class="cart-header">
		<h2>Your cart</h2>
		<button id="cart-close" class="cart-close" type="button" aria-label="Close cart">&times;</button>
	</header>

	<div class="cart-body" id="cart-items">
		<p class="cart-empty" id="cart-empty">Your cart is empty.</p>
	</div>

	<footer class="cart-footer" id="cart-footer" hidden>
		<div class="cart-subtotal">
			<span>Subtotal</span>
			<span id="cart-subtotal">$0.00</span>
		</div>
		<button id="cart-checkout" class="cart-checkout" type="button">Checkout</button>
		<p class="cart-note">Demo checkout — connect a payment provider to enable purchases.</p>
	</footer>
</aside>

<script>
	type CartLine = { id: string; name: string; price: number; image: string; qty: number };
	type Cart = Record<string, CartLine>;

	const STORAGE_KEY = 'msb-cart';

	const drawer = document.getElementById('cart-drawer') as HTMLElement;
	const overlay = document.getElementById('cart-overlay') as HTMLElement;
	const toggle = document.getElementById('cart-toggle') as HTMLButtonElement;
	const closeBtn = document.getElementById('cart-close') as HTMLButtonElement;
	const countEl = document.getElementById('cart-count') as HTMLElement;
	const itemsEl = document.getElementById('cart-items') as HTMLElement;
	const emptyEl = document.getElementById('cart-empty') as HTMLElement;
	const footerEl = document.getElementById('cart-footer') as HTMLElement;
	const subtotalEl = document.getElementById('cart-subtotal') as HTMLElement;
	const checkoutBtn = document.getElementById('cart-checkout') as HTMLButtonElement;

	function loadCart(): Cart {
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			return raw ? (JSON.parse(raw) as Cart) : {};
		} catch {
			return {};
		}
	}

	function saveCart(cart: Cart): void {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
	}

	let cart: Cart = loadCart();

	const money = (n: number): string => '$' + n.toFixed(2);
	const totalCount = (): number => Object.values(cart).reduce((n, l) => n + l.qty, 0);
	const subtotal = (): number => Object.values(cart).reduce((s, l) => s + l.price * l.qty, 0);

	function open(): void {
		drawer.classList.add('open');
		drawer.setAttribute('aria-hidden', 'false');
		overlay.classList.add('open');
		overlay.setAttribute('aria-hidden', 'false');
		toggle.setAttribute('aria-expanded', 'true');
	}

	function close(): void {
		drawer.classList.remove('open');
		drawer.setAttribute('aria-hidden', 'true');
		overlay.classList.remove('open');
		overlay.setAttribute('aria-hidden', 'true');
		toggle.setAttribute('aria-expanded', 'false');
	}

	function render(): void {
		const count = totalCount();
		countEl.textContent = String(count);
		countEl.hidden = count === 0;

		const lines = Object.values(cart);
		itemsEl.querySelectorAll('.cart-line').forEach((n) => n.remove());

		if (lines.length === 0) {
			emptyEl.style.display = '';
			emptyEl.textContent = 'Your cart is empty.';
			footerEl.hidden = true;
			return;
		}

		emptyEl.style.display = 'none';
		footerEl.hidden = false;

		const frag = document.createDocumentFragment();
		for (const line of lines) {
			const el = document.createElement('div');
			el.className = 'cart-line';
			el.dataset.id = line.id;
			el.innerHTML = `
				<div class="cart-line-img" style="background:${line.image};"></div>
				<div class="cart-line-info">
					<h3>${line.name}</h3>
					<div class="cart-line-price">${money(line.price)}</div>
					<div class="cart-line-qty">
						<button type="button" data-qty data-id="${line.id}" data-delta="-1" aria-label="Decrease quantity">&minus;</button>
						<span>${line.qty}</span>
						<button type="button" data-qty data-id="${line.id}" data-delta="1" aria-label="Increase quantity">+</button>
						<button type="button" class="cart-line-remove" data-remove data-id="${line.id}" aria-label="Remove item">Remove</button>
					</div>
				</div>
			`;
			frag.appendChild(el);
		}
		itemsEl.appendChild(frag);

		subtotalEl.textContent = money(subtotal());
	}

	function addToCart(p: { id: string; name: string; price: number; image: string }): void {
		const existing = cart[p.id];
		if (existing) {
			existing.qty += 1;
		} else {
			cart[p.id] = { ...p, qty: 1 };
		}
		saveCart(cart);
		render();
		open();
	}

	function changeQty(id: string, delta: number): void {
		const line = cart[id];
		if (!line) return;
		line.qty += delta;
		if (line.qty <= 0) delete cart[id];
		saveCart(cart);
		render();
	}

	function removeLine(id: string): void {
		delete cart[id];
		saveCart(cart);
		render();
	}

	toggle.addEventListener('click', () => (drawer.classList.contains('open') ? close() : open()));
	closeBtn.addEventListener('click', close);
	overlay.addEventListener('click', close);
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') close();
	});

	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;

		const add = target.closest('.add-to-cart') as HTMLElement | null;
		if (add) {
			e.preventDefault();
			addToCart({
				id: add.dataset.id as string,
				name: add.dataset.name as string,
				price: Number(add.dataset.price),
				image: add.dataset.image as string,
			});
			return;
		}

		const qty = target.closest('[data-qty]') as HTMLElement | null;
		if (qty) {
			changeQty(qty.dataset.id as string, Number(qty.dataset.delta));
			return;
		}

		const rm = target.closest('[data-remove]') as HTMLElement | null;
		if (rm) {
			removeLine(rm.dataset.id as string);
			return;
		}
	});

	checkoutBtn.addEventListener('click', () => {
		if (Object.keys(cart).length === 0) return;
		cart = {};
		saveCart(cart);
		itemsEl.querySelectorAll('.cart-line').forEach((n) => n.remove());
		emptyEl.style.display = '';
		emptyEl.textContent = 'Thanks! This is a demo store — no payment was taken.';
		footerEl.hidden = true;
		countEl.textContent = '0';
		countEl.hidden = true;
	});

	render();
</script>

<style>
	.cart-toggle {
		position: fixed;
		right: 20px;
		bottom: 20px;
		z-index: 60;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 12px 14px;
		border: none;
		border-radius: 999px;
		cursor: pointer;
		color: #fff;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		box-shadow: 0 12px 30px -10px rgba(50, 69, 255, 0.6);
		font-family: Inter, Roboto, 'Helvetica Neue', Arial, sans-serif;
	}

	.cart-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 20px;
		height: 20px;
		padding: 0 5px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 600;
		color: #3245ff;
		background: #fff;
	}

	.cart-count[hidden] {
		display: none;
	}

	.cart-overlay {
		position: fixed;
		inset: 0;
		z-index: 55;
		background: rgba(17, 24, 39, 0.4);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.2s,
			visibility 0.2s;
	}

	.cart-overlay.open {
		opacity: 1;
		visibility: visible;
	}

	.cart-drawer {
		position: fixed;
		top: 0;
		right: 0;
		z-index: 56;
		width: min(420px, 100%);
		height: 100%;
		background: #fff;
		display: flex;
		flex-direction: column;
		transform: translateX(100%);
		transition: transform 0.25s ease;
		box-shadow: -20px 0 60px -30px rgba(17, 24, 39, 0.5);
		font-family: Inter, Roboto, 'Helvetica Neue', Arial, sans-serif;
	}

	.cart-drawer.open {
		transform: translateX(0);
	}

	.cart-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 18px 20px;
		border-bottom: 1px solid rgba(17, 24, 39, 0.08);
	}

	.cart-header h2 {
		margin: 0;
		font-size: 18px;
		font-weight: 600;
		color: #111827;
	}

	.cart-close {
		border: none;
		background: none;
		font-size: 28px;
		line-height: 1;
		color: #6b7280;
		cursor: pointer;
	}

	.cart-close:hover {
		color: #111827;
	}

	.cart-body {
		flex: 1 1 auto;
		overflow-y: auto;
		padding: 8px 20px;
	}

	.cart-empty {
		margin: 0;
		color: #6b7280;
		text-align: center;
		padding: 40px 0;
	}

	.cart-line {
		display: flex;
		gap: 12px;
		padding: 12px 0;
		border-bottom: 1px solid rgba(17, 24, 39, 0.06);
	}

	.cart-line-img {
		width: 56px;
		height: 56px;
		border-radius: 10px;
		flex: 0 0 auto;
	}

	.cart-line-info {
		display: flex;
		flex-direction: column;
		gap: 4px;
		flex: 1 1 auto;
	}

	.cart-line-info h3 {
		margin: 0;
		font-size: 15px;
		font-weight: 600;
		color: #111827;
	}

	.cart-line-price {
		font-size: 14px;
		color: #4b5563;
	}

	.cart-line-qty {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 14px;
		color: #4b5563;
	}

	.cart-line-qty button {
		font-family: inherit;
		font-size: 14px;
		width: 26px;
		height: 26px;
		border: 1px solid rgba(17, 24, 39, 0.12);
		background: #fff;
		border-radius: 8px;
		cursor: pointer;
		color: #111827;
		line-height: 1;
	}

	.cart-line-qty button:hover {
		background: #f3f4f6;
	}

	.cart-line-remove {
		width: auto;
		border: none;
		background: none;
		color: #6b7280;
		padding: 0 4px;
		text-decoration: underline;
		font-size: 13px;
	}

	.cart-footer {
		flex: 0 0 auto;
		padding: 16px 20px 20px;
		border-top: 1px solid rgba(17, 24, 39, 0.08);
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.cart-footer[hidden] {
		display: none;
	}

	.cart-subtotal {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 16px;
		font-weight: 600;
		color: #111827;
	}

	.cart-checkout {
		font-family: inherit;
		font-size: 16px;
		font-weight: 600;
		color: #fff;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		border: none;
		border-radius: 10px;
		padding: 12px;
		cursor: pointer;
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
	}

	.cart-checkout:hover {
		opacity: 0.92;
	}

	.cart-note {
		margin: 0;
		font-size: 12px;
		color: #6b7280;
		text-align: center;
	}

	@media (max-width: 480px) {
		.cart-drawer {
			width: 100%;
		}

		.cart-toggle {
			right: 16px;
			bottom: 16px;
		}
	}
</style>
