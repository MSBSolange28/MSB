---
interface Props {
	id: string;
	name: string;
	price: number;
	emoji: string;
	gradient: [string, string];
	rating: number;
	description: string;
	category: string;
}

const { id, name, price, emoji, gradient, rating, description, category } = Astro.props;
const formattedPrice = `$${price.toFixed(2)}`;
const fullStars = Math.round(rating);
---

<article
	class="product-card"
	data-id={id}
	data-name={name}
	data-price={price}
	data-emoji={emoji}
	data-category={category}
>
	<div
		class="product-image"
		style={`background: linear-gradient(135deg, ${gradient[0]}, ${gradient[1]})`}
	>
		<span class="product-emoji" aria-hidden="true">{emoji}</span>
		<span class="product-category">{category}</span>
	</div>
	<div class="product-info">
		<h3 class="product-name">{name}</h3>
		<div class="product-rating" aria-label={`Rated ${rating} out of 5`}>
			<span class="stars" aria-hidden="true">{'★'.repeat(fullStars)}{'☆'.repeat(5 - fullStars)}</span>
			<span class="rating-value">{rating.toFixed(1)}</span>
		</div>
		<p class="product-desc">{description}</p>
		<div class="product-footer">
			<span class="product-price">{formattedPrice}</span>
			<button class="add-to-cart" type="button" data-id={id}>
				Add to cart
			</button>
		</div>
	</div>
</article>

<style>
	.product-card {
		display: flex;
		flex-direction: column;
		background: #ffffff;
		border: 1px solid rgba(229, 231, 235, 1);
		border-radius: 16px;
		overflow: hidden;
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}

	.product-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 28px rgba(13, 148, 136, 0.16);
	}

	.product-image {
		position: relative;
		aspect-ratio: 4 / 3;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.product-emoji {
		font-size: clamp(48px, 9vw, 72px);
		line-height: 1;
		filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.18));
	}

	.product-category {
		position: absolute;
		top: 10px;
		left: 10px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: #064e3b;
		background: rgba(255, 255, 255, 0.85);
		padding: 3px 9px;
		border-radius: 999px;
		backdrop-filter: blur(6px);
	}

	.product-info {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 16px;
	}

	.product-name {
		margin: 0;
		font-size: 17px;
		font-weight: 600;
		color: #111827;
	}

	.product-rating {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.stars {
		color: #f59e0b;
		letter-spacing: 1px;
		font-size: 13px;
	}

	.rating-value {
		font-size: 13px;
		color: #6b7280;
	}

	.product-desc {
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		color: #4b5563;
		min-height: 42px;
	}

	.product-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 4px;
	}

	.product-price {
		font-size: 18px;
		font-weight: 700;
		color: #0f766e;
	}

	.add-to-cart {
		cursor: pointer;
		border: none;
		color: #ffffff;
		font-size: 14px;
		font-weight: 600;
		padding: 9px 14px;
		border-radius: 10px;
		background: linear-gradient(83.21deg, #0d9488 0%, #10b981 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		transition:
			transform 0.12s ease,
			box-shadow 0.12s ease,
			opacity 0.12s ease;
	}

	.add-to-cart:hover {
		opacity: 0.92;
	}

	.add-to-cart:active {
		transform: scale(0.96);
		box-shadow: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.product-card,
		.add-to-cart {
			transition: none;
		}
		.product-card:hover {
			transform: none;
		}
	}
</style>
