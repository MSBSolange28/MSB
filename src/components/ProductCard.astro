---
import type { Product } from '../data/products';

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<article class="product-card" data-id={product.id} data-category={product.category}>
	<div class="product-image" style={`background: ${product.gradient};`}>
		<span class="product-initial">{product.initial}</span>
	</div>
	<div class="product-info">
		<span class="product-category">{product.category}</span>
		<h3 class="product-name">{product.name}</h3>
		<p class="product-desc">{product.description}</p>
		<div class="product-footer">
			<span class="product-price">${product.price.toFixed(2)}</span>
			<button
				class="add-to-cart"
				type="button"
				data-id={product.id}
				data-name={product.name}
				data-price={product.price}
				data-image={product.gradient}
			>
				Add to cart
			</button>
		</div>
	</div>
</article>

<style>
	.product-card {
		display: flex;
		flex-direction: column;
		background: #fff;
		border: 1px solid rgba(17, 24, 39, 0.08);
		border-radius: 16px;
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.product-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 18px 40px -24px rgba(17, 24, 39, 0.35);
	}

	.product-image {
		aspect-ratio: 4 / 3;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.product-initial {
		font-family: Inter, Roboto, 'Helvetica Neue', Arial, sans-serif;
		font-size: 56px;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.92);
		letter-spacing: -0.02em;
	}

	.product-info {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 16px;
	}

	.product-category {
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #6b7280;
	}

	.product-name {
		margin: 0;
		font-size: 17px;
		font-weight: 600;
		color: #111827;
	}

	.product-desc {
		margin: 0;
		font-size: 14px;
		line-height: 20px;
		color: #4b5563;
	}

	.product-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 8px;
	}

	.product-price {
		font-size: 17px;
		font-weight: 600;
		color: #111827;
	}

	.add-to-cart {
		font-family: inherit;
		font-size: 14px;
		font-weight: 500;
		color: #fff;
		background: linear-gradient(83.21deg, #0d9488 0%, #10b981 100%);
		border: none;
		border-radius: 10px;
		padding: 9px 14px;
		cursor: pointer;
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		transition: opacity 0.2s;
	}

	.add-to-cart:hover {
		opacity: 0.92;
	}

	.add-to-cart:active {
		transform: translateY(1px);
	}

	@media (max-width: 480px) {
		.product-initial {
			font-size: 44px;
		}
	}
</style>
